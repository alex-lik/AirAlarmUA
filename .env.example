# AirAlarmUA configuration
# Copy this file to .env and set your values
#
#   cp .env.example .env

# App
PORT=8000
LOG_LEVEL=INFO
# Optional file logging (unset by default, logs go to stdout)
# LOG_FILE=./logs/app.log

# CORS (comma-separated list, "*" for development)
CORS_ORIGINS=*

# Rate limiting (slowapi format)
RATE_LIMIT=100/10minutes

# alerts.in.ua API
ALERTS_API_TOKEN=your_alerts_api_token_here
ALERTS_API_URL=https://api.alerts.in.ua/v1/iot/active_air_raid_alerts.json
UPDATE_INTERVAL=60
REQUEST_TIMEOUT=15
MAX_RETRIES=3
MAX_FAILURES=5

# Telegram notifications (optional)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=123456789

# Sentry error tracking (optional)
SENTRY_DSN=
